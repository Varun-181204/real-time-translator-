# OmniTranslate AI Environment Variables

# (Optional) Google Gemini API Key.
# If left blank, you can enter your key directly inside the Web UI Profile Settings,
# or use the system environment GEMINI_API_KEY.
GEMINI_API_KEY=

# Flask session signing key (set a long random value for persistent sessions)
SECRET_KEY=

# Server Port (default: 5000)
PORT=5000
